ARG R_VERSION=4.4
FROM rocker/rstudio:${R_VERSION}

ARG R_VERSION
ENV R_VERSION=${R_VERSION}

# build time variables
ARG BUILD_DATE="000000"
ENV BUILD_DATE=${BUILD_DATE}
ARG BUILD_TAG="000000"
ENV BUILD_TAG=${BUILD_TAG}
ARG REPONAME="000000"
ENV REPONAME=${REPONAME}

RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
      openssh-client \
      python3-pip python3-dev python3-venv && \
    python3 -m venv /opt/pyenv && \
    /opt/pyenv/bin/pip3 install --no-cache-dir --upgrade pip && \
    /opt/pyenv/bin/pip3 install --no-cache-dir pre-commit && \
    sh -c "$(wget -O- https://github.com/deluan/zsh-in-docker/releases/download/v1.2.1/zsh-in-docker.sh)" -- \
      -p git -p ssh-agent && \
      chsh -s /bin/zsh && \
    rm -rf ~/.cache/pip* && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* && \
    apt-get autoclean && apt-get autoremove -y && \
    rm -rf /var/lib/{apt,dpkg,cache,log}/

ENV PATH="/opt/pyenv/bin:/opt/:$PATH"
ENV PKG_INCLUDE_LINKINGTO=TRUE

RUN Rscript -e 'install.packages("pak", repos = sprintf("https://r-lib.github.io/p/pak/stable/%s/%s/%s", .Platform$pkgType, R.Version()$os, R.Version()$arch))' && \
    Rscript -e 'pak::pkg_install(c("devtools", "tidyverse"))'

RUN --mount=type=bind,source=DESCRIPTION,target=/opt/MOSuite/DESCRIPTION \
    --mount=type=bind,source=docker/install_dev.R,target=/opt/install_dev.R \
    Rscript /opt/install_dev.R

WORKDIR /data2
CMD ["/bin/bash"]
